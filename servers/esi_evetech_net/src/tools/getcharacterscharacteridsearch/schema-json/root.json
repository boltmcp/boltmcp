{
  "type": "object",
  "properties": {
    "character_id": {
      "description": "The ID of the character",
      "example": 90000001,
      "format": "int64",
      "type": "integer",
      "x-common-model": "true"
    },
    "categories": {
      "description": "Type of entities to search for",
      "items": {
        "enum": [
          "agent",
          "alliance",
          "character",
          "constellation",
          "corporation",
          "faction",
          "inventory_type",
          "region",
          "solar_system",
          "station",
          "structure"
        ],
        "type": "string"
      },
      "maxItems": 11,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "search": {
      "description": "The string to search on",
      "type": "string"
    },
    "strict": {
      "description": "Whether the search should be a strict match",
      "default": false,
      "type": "boolean"
    },
    "Accept-Language": {
      "description": "The language to use for the response. Defaults to 'en'.",
      "enum": [
        "en",
        "de",
        "fr",
        "ja",
        "ru",
        "zh",
        "ko",
        "es"
      ],
      "type": "string"
    },
    "If-None-Match": {
      "description": "The ETag of the previous request. A 304 will be returned if this matches the current ETag.",
      "type": "string"
    },
    "X-Compatibility-Date": {
      "description": "The compatibility date for the request.",
      "format": "date",
      "type": "string"
    },
    "X-Tenant": {
      "description": "The tenant ID for the request. Defaults to 'tranquility'.",
      "type": "string"
    }
  },
  "required": [
    "character_id",
    "categories",
    "search",
    "X-Compatibility-Date"
  ]
}