{
  "description": "<dfn class=\"text-muted\">optional, string filter</dfn><br>Filter attached items based on their id.<br><b>Supported operators : </b>is, is_not, starts_with, in, not_in<br><br><b>Example <span class=\"cb-char-arrow\">→</span> </b><i>id[is] = \"bec0c324-adb6-44d3-ad4f-694f449be97c\"</i>",
  "type": "object",
  "properties": {
    "is": {
      "minLength": 1,
      "type": "string"
    },
    "is_not": {
      "minLength": 1,
      "type": "string"
    },
    "starts_with": {
      "minLength": 1,
      "type": "string"
    },
    "in": {
      "pattern": "^\\[(.*)(,.*)*\\]$",
      "type": "string"
    },
    "not_in": {
      "pattern": "^\\[(.*)(,.*)*\\]$",
      "type": "string"
    }
  },
  "example": "bec0c324-adb6-44d3-ad4f-694f449be97c",
  "deprecated": false
}