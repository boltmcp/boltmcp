{
  "description": "<dfn class=\"text-muted\">optional, string filter</dfn><br>Unique coupon code that can be redeemed only once.<br><b>Supported operators : </b>is, is_not, starts_with, in, not_in<br><br><b>Example <span class=\"cb-char-arrow\">→</span> </b><i>code[is_not] = \"OFF2009\"</i>",
  "type": "object",
  "properties": {
    "is": {
      "minLength": 1,
      "type": "string"
    },
    "is_not": {
      "minLength": 1,
      "type": "string"
    },
    "starts_with": {
      "minLength": 1,
      "type": "string"
    },
    "in": {
      "pattern": "^\\[(.*)(,.*)*\\]$",
      "type": "string"
    },
    "not_in": {
      "pattern": "^\\[(.*)(,.*)*\\]$",
      "type": "string"
    }
  },
  "example": "OFF2009",
  "deprecated": false
}