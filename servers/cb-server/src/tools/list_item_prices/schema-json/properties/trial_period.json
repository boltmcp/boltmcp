      "type": "string",
      "format": "number"
    },
    "lte": {
      "pattern": "^-?\\d+$",
      "type": "string",
      "format": "number"
    },
    "gt": {
      "pattern": "^-?\\d+$",
      "type": "string",
      "format": "number"
    },
    "gte": {
