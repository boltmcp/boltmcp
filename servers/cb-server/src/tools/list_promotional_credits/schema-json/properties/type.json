{
  "description": "<dfn class=\"text-muted\">optional, enumerated string filter</dfn><br>Type of promotional credits. Possible values are : <dfn>increment, decrement.</dfn><br><b>Supported operators : </b>is, is_not, in, not_in<br><br><b>Example <span class=\"cb-char-arrow\">→</span> </b><i>type[is] = \"increment\"</i>",
  "type": "object",
  "properties": {
    "is": {
      "type": "string",
      "description": "\\* \\`increment\\` - Increment \\* \\`decrement\\` - Decrement\n",
      "enum": [
        "increment",
        "decrement"
      ]
    },
    "is_not": {
      "type": "string",
      "description": "\\* \\`increment\\` - Increment \\* \\`decrement\\` - Decrement\n",
      "enum": [
        "increment",
        "decrement"
      ]
    },
    "in": {
      "pattern": "^\\[(increment|decrement)(,(increment|decrement))*\\]$",
      "type": "string"
    },
    "not_in": {
      "pattern": "^\\[(increment|decrement)(,(increment|decrement))*\\]$",
      "type": "string"
    }
  },
  "example": "increment",
  "deprecated": false
}