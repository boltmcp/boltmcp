      "minimum": 1,
      "default": 1,
      "title": "Page"
    },
    "per_page": {
      "description": "Itens por página",
      "type": "integer",
      "maximum": 100,
      "minimum": 1,
      "default": 20,
      "title": "Per Page"
    },
    "company_id": {
      "description": "Filtrar por empresa",
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "title": "Company Id"
    },
    "status": {
      "description": "Filtrar por status",
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "backlog",
            "todo",
            "in_progress",
            "review",
            "testing",
            "done",
            "cancelled"
          ],
          "title": "WorkOrderStatus",
          "description": "Status das ordens de serviço (Kanban)"
