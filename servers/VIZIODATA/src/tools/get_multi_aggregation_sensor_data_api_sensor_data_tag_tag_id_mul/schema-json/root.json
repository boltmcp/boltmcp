{
  "type": "object",
  "properties": {
    "tag_id": {
      "type": "string",
      "title": "Tag Id"
    },
    "start_time": {
      "description": "Start time for data aggregation",
      "type": "string",
      "format": "date-time",
      "title": "Start Time"
    },
    "end_time": {
      "description": "End time for data aggregation",
      "type": "string",
      "format": "date-time",
      "title": "End Time"
    },
    "aggregations": {
      "description": "Comma-separated aggregation types",
      "type": "string",
      "default": "raw,1min,5min,10min,15min,30min",
      "title": "Aggregations"
    },
    "limit": {
      "description": "Maximum number of points per aggregation (auto-adjusted for long periods)",
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ],
      "default": 1000,
      "title": "Limit"
    }
  },
  "required": [
    "tag_id",
    "start_time",
    "end_time"
  ]
}