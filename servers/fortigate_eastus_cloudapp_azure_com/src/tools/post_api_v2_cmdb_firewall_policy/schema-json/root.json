      "type": "string",
      "format": "date-time",
      "description": "Policy expiry date (YYYY-MM-DD HH:MM:SS).",
      "default": "0000-00-00 00:00:00"
    },
    "policy-expiry-date-utc": {
      "type": "string",
      "description": "Policy expiry date and time, in epoch format.",
      "default": ""
    },
    "service": {
      "type": "string",
      "description": "Service and service group names."
    },
    "tos-mask": {
      "type": "string",
      "description": "Non-zero bit positions are used for comparison while zero bit positions are ignored.",
      "default": ""
    },
    "tos": {
      "type": "string",
      "description": "ToS (Type of Service) value used for comparison.",
      "default": ""
    },
    "tos-negate": {
      "type": "string",
      "description": "Enable negated TOS match.",
      "default": "disable",
      "enum": [
        "enable",
        "disable"
      ]
    },
    "anti-replay": {
      "type": "string",
      "description": "Enable/disable anti-replay check.",
      "default": "enable",
      "enum": [
        "enable",
        "disable"
      ]
    },
    "tcp-session-without-syn": {
      "type": "string",
