      "default": "disable",
      "enum": [
        "all",
        "data-only",
        "disable"
      ]
    },
    "geoip-anycast": {
      "type": "string",
      "description": "Enable/disable recognition of anycast IP addresses using the geography IP database.",
      "default": "disable",
      "enum": [
        "enable",
        "disable"
      ]
    },
