{
  "type": "object",
  "properties": {
    "bookId": {
      "description": "The book's id.",
      "type": "string",
      "format": "guid"
    },
    "supplierId": {
      "description": "The supplier's id.",
      "type": "string",
      "format": "guid"
    },
    "countryCode": {
      "type": "string",
      "description": "The country code.",
      "default": "null",
      "maxLength": 10,
      "nullable": true,
      "example": "61"
    },
    "areaCode": {
      "type": "string",
      "description": "The area code.",
      "default": "null",
      "maxLength": 10,
      "nullable": true,
      "example": "02"
    },
    "number": {
      "type": "string",
      "description": "The number.",
      "default": "null",
      "maxLength": 30,
      "nullable": true,
      "example": "90101234"
    },
    "extension": {
      "type": "string",
      "description": "The extension.",
      "default": "null",
      "maxLength": 10,
      "nullable": true,
      "example": "4321"
    },
    "type": {
      "type": "string",
      "description": "The id or name of the phone number type.",
      "minLength": 1,
      "example": "Work"
    }
  },
  "required": [
    "bookId",
    "supplierId",
    "type"
  ]
