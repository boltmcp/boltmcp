{
  "type": "object",
  "properties": {
    "bookId": {
      "description": "The book's id.",
      "type": "string",
      "format": "guid"
    },
    "creditNoteId": {
      "description": "The credit note's id.",
      "type": "string",
      "format": "guid"
    },
    "customer": {
      "type": "string",
      "description": "The customer that the credit note will be issued to.",
      "minLength": 1,
      "example": "Company Ltd"
    },
    "creditNoteDate": {
      "type": "string",
      "description": "The date of the credit note.",
      "format": "date-time",
      "minLength": 1,
      "example": "2020-02-06"
    },
    "amountTaxStatus": {
      "description": "The amount tax status of the amounts in the credit note.",
      "example": "Inclusive",
      "anyOf": [
        {
          "type": "string",
          "description": "The tax status of an amount.",
          "x-enumNames": [
            "NonTaxed",
            "Inclusive",
            "Exclusive"
          ],
          "enum": [
            "NonTaxed",
            "Inclusive",
            "Exclusive"
          ]
        }
      ]
    },
    "reference": {
      "type": "string",
      "description": "The credit note reference.",
      "default": "null",
      "nullable": true,
      "example": "My reference"
    },
    "accountsReceivableLedgerAccount": {
      "type": "string",
      "readOnly": true,
      "description": "The accounts receivable ledger account.\n_Note:_ It is not currently possible to create multiple Accounts Receivable accounts so this field is read-only and will be ignored.",
      "default": "The default Accounts Receivable account",
      "nullable": true,
      "example": "Accounts Receivable"
    },
    "classification": {
      "type": "string",
      "description": "The classification.",
      "default": "null",
      "nullable": true,
      "example": "My classification"
    },
    "template": {
      "type": "string",
      "description": "The template used to print or email the credit note.",
      "default": "null",
      "minLength": 1,
      "example": "Professional Customer Adjustment Note"
    },
    "lineItems": {
      "type": "array",
      "description": "The individual items that make up the credit note.",
      "items": {
        "type": "object",
        "description": "Details of a credit note line item to create or update.",
        "additionalProperties": false,
        "required": [
          "lineNumber"
        ],
        "properties": {
          "lineNumber": {
            "type": "integer",
            "description": "The line number.",
            "format": "int32",
            "example": 2
          },
          "project": {
            "type": "string",
            "description": "The id or full name of the project that the line item relates to.\nNote that the full name includes the name(s) of any parent project(s) separated by colons.",
            "default": "null",
            "nullable": true,
            "example": "Project A:Project B:Project C"
          },
          "itemDetails": {
            "description": "Details of an item used on an invoice line item.\nThis must be omitted if `accountDetails` have been provided.",
            "default": "null",
            "nullable": true,
            "anyOf": [
              {
                "type": "object",
                "description": "Details of an item used on a credit note line item.",
                "additionalProperties": false,
                "required": [
                  "item"
                ],
                "properties": {
                  "item": {
                    "type": "string",
                    "description": "The id or full name of the item that the line relates to.\nNote that the full name includes the name(s) of any parent item(s) separated by colons.",
                    "minLength": 1,
                    "example": "Parent item:Child item"
                  },
                  "price": {
                    "type": "number",
                    "description": "The price of each item including or excluding tax (depending on the `amountTaxStatus`).",
                    "format": "decimal",
                    "default": "null",
                    "nullable": true,
                    "example": 5.5
                  },
                  "quantity": {
                    "type": "number",
                    "description": "The quantity purchased.",
                    "format": "decimal",
                    "default": "nulll",
                    "nullable": true,
                    "example": 1
                  }
                }
              }
            ]
          },
          "accountDetails": {
            "description": "Details of an account used on an invoice line item.\nThis must be omitted if `itemDetails` have been provided.",
            "default": "null",
            "nullable": true,
            "anyOf": [
              {
                "type": "object",
                "description": "Details of an account used on a credit note line item.",
                "additionalProperties": false,
                "required": [
                  "ledgerAccount"
                ],
                "properties": {
                  "ledgerAccount": {
                    "type": "string",
                    "description": "The id or full name of the ledger account that the line relates to.\nNote that the full name includes the name(s) of any parent account(s) separated by colons.",
                    "minLength": 1,
                    "example": "Income:Sub income"
                  },
                  "quantity": {
                    "type": "number",
                    "description": "The quantity purchased.",
                    "format": "decimal",
                    "default": "nulll",
                    "nullable": true,
                    "example": 1
                  },
                  "amount": {
                    "type": "number",
                    "description": "The amount including or excluding tax (depending on the `amountTaxStatus`).",
                    "format": "decimal",
                    "default": 0,
                    "nullable": true,
                    "example": 110
                  }
                }
              }
            ]
          },
          "description": {
            "type": "string",
            "description": "The description of the line.",
            "default": "null",
            "nullable": true,
            "example": "This is my new line"
          },
          "taxAmount": {
            "type": "number",
            "description": "The tax amount.",
            "format": "decimal",
            "default": "null",
            "nullable": true,
            "example": 10
          },
          "taxRate": {
            "type": "string",
            "description": "The tax rate.",
            "default": "null",
            "nullable": true,
            "example": "GST"
          },
          "taxIsModified": {
            "type": "boolean",
            "readOnly": true,
            "description": "Whether the tax amount has been modified.",
            "default": "null",
            "nullable": true,
            "example": false
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "Notes related to the credit note.",
      "default": "null",
      "nullable": true,
      "example": "This is a note."
    }
  },
  "required": [
    "bookId",
    "creditNoteId",
    "customer",
    "creditNoteDate",
    "amountTaxStatus",
    "template",
    "lineItems"
  ]
}