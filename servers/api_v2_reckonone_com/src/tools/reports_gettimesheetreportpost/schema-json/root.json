{
  "type": "object",
  "properties": {
    "bookId": {
      "description": "The book's id.",
      "type": "string",
      "format": "guid"
    },
    "parameters": {
      "description": "The report parameters.",
      "oneOf": [
        {
          "nullable": true,
          "oneOf": [
            {
              "type": "object",
              "description": "The parameters for the timesheet report.",
              "additionalProperties": false,
              "properties": {
                "token": {
                  "type": "string",
                  "description": "An authentication token. Note that this is not required if it is supplied via the HTTP `Authorize` header.",
                  "nullable": true,
                  "example": "asdkfasdfkjasdgfgarekjhgfu2g8378rffcbwdhjbjdhk3cfoch3c3"
                },
                "period": {
                  "description": "The period.",
                  "default": "AllDates",
                  "nullable": true,
                  "example": "AllDates",
                  "oneOf": [
                    {
                      "type": "string",
                      "description": "Periods that can be used for the Super Transactions report.",
                      "x-enumNames": [
                        "AllDates",
                        "SpecifiedDates"
                      ],
                      "enum": [
                        "AllDates",
                        "SpecifiedDates"
                      ]
                    }
                  ]
                },
                "fromDate": {
                  "type": "string",
                  "description": "The 'from' date for the report.\nOnly required if `period` is `SpecifiedDates`.",
                  "format": "date-time",
                  "default": "null",
                  "nullable": true,
                  "example": "2021-01-01"
                },
                "toDate": {
                  "type": "string",
                  "description": "The 'to' date for the report.\nOnly required if `period` is `SpecifiedDates`.",
                  "format": "date-time",
                  "default": "null",
                  "nullable": true,
                  "example": "2021-12-31"
                },
                "groupBy": {
                  "description": "The data grouping for the report.",
                  "default": "None",
                  "oneOf": [
                    {
                      "type": "string",
                      "description": "Grouping option for timesheet report.",
                      "x-enumNames": [
                        "None",
                        "Employee",
                        "Project",
                        "Classification",
                        "Customer",
                        "ServiceItem",
                        "BillableStatus",
                        "TimesheetStatus",
                        "WeeklyPeriod"
                      ],
                      "enum": [
                        "None",
                        "Employee",
                        "Project",
                        "Classification",
                        "Customer",
                        "ServiceItem",
                        "BillableStatus",
                        "TimesheetStatus",
                        "WeeklyPeriod"
                      ]
                    }
                  ]
                },
                "employees": {
                  "type": "array",
                  "description": "A list of employee IDs to include in the report.\nIf omitted, all employees will be included.",
                  "default": "null",
                  "nullable": true,
                  "example": [
                    "3e3b17cc-9071-4822-893e-9ef67dbf572c"
                  ],
                  "items": {
                    "type": "string",
                    "format": "guid"
                  }
                },
                "projects": {
                  "type": "array",
                  "description": "A list of project IDs to include in the report.\nIf omitted, all projects will be included.",
                  "default": "null",
                  "nullable": true,
                  "example": [
                    "bfe62dbb-2ecb-4948-8a9a-efeacb84386d"
                  ],
                  "items": {
                    "type": "string",
                    "format": "guid"
                  }
                },
                "classifications": {
                  "type": "array",
                  "description": "A list of classification IDs to include in the report.\nIf omitted, all classifications will be included.",
                  "default": "null",
                  "nullable": true,
                  "example": [
                    "fa2877aa-dcc6-464a-b64f-556b66026689"
                  ],
                  "items": {
                    "type": "string",
                    "format": "guid"
                  }
                },
                "customers": {
                  "type": "array",
                  "description": "A list of customer IDs to include in the report.\nIf omitted, all customers will be included.",
                  "default": "null",
                  "nullable": true,
                  "example": [
                    "e214d5b4-7bda-4e4b-b0b4-5ffe6b7ac19b"
                  ],
                  "items": {
                    "type": "string",
                    "format": "guid"
                  }
                },
                "serviceItems": {
                  "type": "array",
                  "description": "A list of service item IDs to include in the report.\nIf omitted, all service items will be included.",
                  "default": "null",
                  "nullable": true,
                  "example": [
                    "b9b11d3e-9eb5-4dc9-b3a9-e2afe7d07460"
                  ],
                  "items": {
                    "type": "string",
                    "format": "guid"
                  }
                },
                "status": {
                  "type": "array",
                  "description": "The billing statuses to include in the report.\nIf omitted, all billing statuses will be included.",
                  "default": "null",
                  "nullable": true,
                  "example": [
                    "NonBillable",
                    "Invoiced"
                  ],
                  "items": {
                    "type": "string",
                    "description": "Timesheet entry's billing status.",
                    "x-enumNames": [
                      "NonBillable",
                      "Billable",
                      "Invoiced",
                      "Billed"
                    ],
                    "enum": [
                      "NonBillable",
                      "Billable",
                      "Invoiced",
                      "Billed"
                    ]
                  }
                },
                "timesheetStatus": {
                  "type": "array",
                  "description": "The timesheet statuses to include in the report.\nIf omitted, all timesheet statuses will be included.",
                  "default": "null",
                  "nullable": true,
                  "example": [
                    "Draft",
                    "Submitted"
                  ],
                  "items": {
                    "type": "string",
                    "description": "Timesheet status.",
                    "x-enumNames": [
                      "Draft",
                      "Submitted",
                      "Declined",
                      "Approved"
                    ],
                    "enum": [
                      "Draft",
                      "Submitted",
                      "Declined",
                      "Approved"
                    ]
                  }
                },
                "orientation": {
                  "description": "The report's orientation.",
                  "default": "Portrait",
                  "nullable": true,
                  "example": "Portrait",
                  "oneOf": [
                    {
                      "type": "string",
                      "description": "The report orientation.",
                      "x-enumNames": [
                        "Portrait",
                        "Landscape"
                      ],
                      "enum": [
                        "Portrait",
                        "Landscape"
                      ]
                    }
                  ]
                },
                "columns": {
                  "type": "array",
                  "description": "A list of columns to include in the report.\nIf omitted, all columns will be returned.",
                  "default": "null",
                  "nullable": true,
                  "example": [
                    "Employee",
                    "Notes"
                  ],
                  "items": {
                    "type": "string",
                    "description": "Timesheet Report columns.",
                    "x-enumNames": [
                      "Employee",
                      "Project",
                      "Classification",
                      "Customer",
                      "ServiceItem",
                      "BillableStatus",
                      "TimesheetStatus",
                      "Notes"
                    ],
                    "enum": [
                      "Employee",
                      "Project",
                      "Classification",
                      "Customer",
                      "ServiceItem",
                      "BillableStatus",
                      "TimesheetStatus",
                      "Notes"
                    ]
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "format": {
      "description": "The format to use, e.g. pdf.",
      "type": "string",
      "nullable": true
    },
    "download": {
      "description": "Whether the result is for download. If true, a ContentDisposition header will be added.",
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "bookId"
  ]
}