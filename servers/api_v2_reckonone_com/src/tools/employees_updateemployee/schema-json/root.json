{
  "type": "object",
  "properties": {
    "bookId": {
      "description": "The book's id.",
      "type": "string",
      "format": "guid"
    },
    "employeeId": {
      "description": "The employee's id.",
      "type": "string",
      "format": "guid"
    },
    "name": {
      "type": "string",
      "description": "The employee's display name.",
      "maxLength": 100,
      "minLength": 1,
      "example": "Joe Bloggs"
    },
    "firstName": {
      "type": "string",
      "description": "The employee's first name.",
      "maxLength": 100,
      "minLength": 1,
      "example": "Joe"
    },
    "surname": {
      "type": "string",
      "description": "The employee's last name.",
      "maxLength": 100,
      "minLength": 1,
      "example": "Bloggs"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes about the employee.",
      "maxLength": 1000,
      "nullable": true,
      "example": "Notes about the employee."
    },
    "businessNumber1": {
      "type": "string",
      "description": "The employee's business number 1.",
      "maxLength": 30,
      "nullable": true,
      "example": "14003348730"
    },
    "businessNumber2": {
      "type": "string",
      "description": "The employee's business number 2.",
      "maxLength": 30,
      "nullable": true,
      "example": "14003348731"
    },
    "status": {
      "description": "The status of the employee.",
      "default": "Active",
      "nullable": true,
      "example": "Active",
      "anyOf": [
        {
          "type": "string",
          "description": "The status of a contact.",
          "x-enumNames": [
            "Active",
            "Inactive"
          ],
          "enum": [
            "Active",
            "Inactive"
          ]
        }
      ]
    },
    "addresses": {
      "type": "array",
      "description": "List of addresses.",
      "nullable": true,
      "items": {
        "type": "object",
        "description": "Details of an address to create or update.",
        "additionalProperties": false,
        "required": [
          "type"
        ],
        "properties": {
          "line1": {
            "type": "string",
            "description": "Line 1 of the address.",
            "default": "null",
            "maxLength": 80,
            "nullable": true,
            "example": "Level 2"
          },
          "line2": {
            "type": "string",
            "description": "Line 2 of the address.",
            "default": "null",
            "maxLength": 80,
            "nullable": true,
            "example": "100 Pacific Highway"
          },
          "line3": {
            "type": "string",
            "description": "Line 3 of the address.",
            "default": "null",
            "maxLength": 80,
            "nullable": true,
            "example": "Line 3"
          },
          "suburb": {
            "type": "string",
            "description": "The suburb.",
            "default": "null",
            "maxLength": 80,
            "nullable": true,
            "example": "North Sydney"
          },
          "town": {
            "type": "string",
            "description": "The town.",
            "default": "null",
            "maxLength": 80,
            "nullable": true,
            "example": "Sydney"
          },
          "state": {
            "type": "string",
            "description": "The state.",
            "default": "null",
            "maxLength": 80,
            "nullable": true,
            "example": "NSW"
          },
          "postcode": {
            "type": "string",
            "description": "The post code.",
            "default": "null",
            "maxLength": 30,
            "nullable": true,
            "example": "2060"
          },
          "country": {
            "type": "string",
            "description": "The country.",
            "default": "null",
            "maxLength": 30,
            "nullable": true,
            "example": "Australia"
          },
          "type": {
            "type": "string",
            "description": "The id or name of the address type.",
            "minLength": 1,
            "example": "Billing"
          }
        }
      }
    },
    "phoneNumbers": {
      "type": "array",
      "description": "List of phone numbers.",
      "nullable": true,
      "items": {
        "type": "object",
        "description": "Details of a phone number to create or update.",
        "additionalProperties": false,
        "required": [
          "type"
        ],
        "properties": {
          "countryCode": {
            "type": "string",
            "description": "The country code.",
            "default": "null",
            "maxLength": 10,
            "nullable": true,
            "example": "61"
          },
          "areaCode": {
            "type": "string",
            "description": "The area code.",
            "default": "null",
            "maxLength": 10,
            "nullable": true,
            "example": "02"
          },
          "number": {
            "type": "string",
            "description": "The number.",
            "default": "null",
            "maxLength": 30,
            "nullable": true,
            "example": "90101234"
          },
          "extension": {
            "type": "string",
            "description": "The extension.",
            "default": "null",
            "maxLength": 10,
            "nullable": true,
            "example": "4321"
          },
          "type": {
            "type": "string",
            "description": "The id or name of the phone number type.",
            "minLength": 1,
            "example": "Work"
          }
        }
      }
    },
    "electronicAddresses": {
      "type": "array",
      "description": "List of electronic addresses.",
      "nullable": true,
      "items": {
        "type": "object",
        "description": "Details of an electronic address to create or update.",
        "additionalProperties": false,
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "The id or name of the electronic address type.",
            "minLength": 1,
            "example": "Email"
          },
          "address": {
            "type": "string",
            "description": "The electronic address.",
            "default": "null",
            "maxLength": 100,
            "nullable": true,
            "example": "x@y.com"
          }
        }
      }
    }
  },
  "required": [
    "bookId",
    "employeeId",
    "name",
    "firstName",
    "surname"
  ]
}