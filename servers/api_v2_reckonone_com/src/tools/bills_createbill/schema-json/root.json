{
  "type": "object",
  "properties": {
    "bookId": {
      "description": "The book's id.",
      "type": "string",
      "format": "guid"
    },
    "supplier": {
      "type": "string",
      "description": "The supplier that is being billed.",
      "minLength": 1,
      "example": "Company Ltd"
    },
    "billDate": {
      "type": "string",
      "description": "The date of the bill.",
      "format": "date-time",
      "minLength": 1,
      "example": "2020-02-06"
    },
    "dueDate": {
      "type": "string",
      "description": "The date bill is due by.",
      "format": "date-time",
      "default": "null",
      "nullable": true,
      "example": "2020-03-06"
    },
    "billDiscountAmount": {
      "type": "number",
      "description": "The bill discount amount.",
      "format": "decimal",
      "default": "null",
      "nullable": true,
      "example": 10
    },
    "billDiscountPercent": {
      "type": "number",
      "description": "The bill discount percentage.",
      "format": "decimal",
      "default": "null",
      "nullable": true,
      "example": 7.5
    },
    "amountTaxStatus": {
      "description": "The amount tax status of the amounts in the bill.",
      "example": "Inclusive",
      "anyOf": [
        {
          "type": "string",
          "description": "The tax status of an amount.",
          "x-enumNames": [
            "NonTaxed",
            "Inclusive",
            "Exclusive"
          ],
          "enum": [
            "NonTaxed",
            "Inclusive",
            "Exclusive"
          ]
        }
      ]
    },
    "reference": {
      "type": "string",
      "description": "The bill reference.",
      "default": "null",
      "nullable": true,
      "example": "My reference"
    },
    "classification": {
      "type": "string",
      "description": "The classification.",
      "default": "null",
      "nullable": true,
      "example": "My classification"
    },
    "template": {
      "type": "string",
      "description": "The template used to print or email the bill.",
      "default": "The default bill template",
      "nullable": true,
      "example": "Professional bill"
    },
    "lineItems": {
      "type": "array",
      "description": "The individual items that make up the bill.",
      "items": {
        "type": "object",
        "description": "Details of an bill line item to create or update.",
        "additionalProperties": false,
        "required": [
          "lineNumber"
        ],
        "properties": {
          "lineNumber": {
            "type": "integer",
            "description": "The line number.",
            "format": "int32",
            "example": 2
          },
          "project": {
            "type": "string",
            "description": "The id or full name of the project that the line item relates to.\nNote that the full name includes the name(s) of any parent project(s) separated by colons.",
            "default": "null",
            "nullable": true,
            "example": "Project A:Project B:Project C"
          },
          "itemDetails": {
            "description": "Details of an item used on an bill line item.\nThis must be omitted if `accountDetails` have been provided.",
            "default": "null",
            "nullable": true,
            "anyOf": [
              {
                "type": "object",
                "description": "Details of an item used on an bill line item.",
                "additionalProperties": false,
                "required": [
                  "item"
                ],
                "properties": {
                  "item": {
                    "type": "string",
                    "description": "The id or full name of the item that the line relates to.\nNote that the full name includes the name(s) of any parent item(s) separated by colons.",
                    "minLength": 1,
                    "example": "Parent item:Child item"
                  },
                  "price": {
                    "type": "number",
                    "description": "The price of each item including or excluding tax (depending on the `amountTaxStatus`).",
                    "format": "decimal",
                    "default": "null",
                    "nullable": true,
                    "example": 5.5
                  },
                  "quantity": {
                    "type": "number",
                    "description": "The quantity purchased.",
                    "format": "decimal",
                    "default": "null",
                    "nullable": true,
                    "example": 1
                  },
                  "discountAmount": {
                    "type": "number",
                    "description": "The total discount for the line item.",
                    "format": "decimal",
                    "default": "null",
                    "nullable": true,
                    "example": 10
                  },
                  "discountPercent": {
                    "type": "number",
                    "description": "The discount percentage for the line item.",
                    "format": "decimal",
                    "default": "null",
                    "nullable": true,
                    "example": 25
                  }
                }
              }
            ]
          },
          "accountDetails": {
            "description": "Details of an account used on an bill line item.\nThis must be omitted if `itemDetails` have been provided.",
            "default": "null",
            "nullable": true,
            "anyOf": [
              {
                "type": "object",
                "description": "Details of an account used on an bill line item.",
                "additionalProperties": false,
                "required": [
                  "ledgerAccount"
                ],
                "properties": {
                  "ledgerAccount": {
                    "type": "string",
                    "description": "The id or full name of the ledger account that the line relates to.\nNote that the full name includes the name(s) of any parent account(s) separated by colons.",
                    "minLength": 1,
                    "example": "Income:Sub income"
                  },
                  "quantity": {
                    "type": "number",
                    "description": "The quantity purchased.",
                    "format": "decimal",
                    "default": "null",
                    "nullable": true,
                    "example": 1
                  },
                  "amount": {
                    "type": "number",
                    "description": "The amount including or excluding tax (depending on the `amountTaxStatus`).",
                    "format": "decimal",
                    "default": 0,
                    "nullable": true,
                    "example": 110
                  }
                }
              }
            ]
          },
          "description": {
            "type": "string",
            "description": "The description of the line.",
            "default": "null",
            "nullable": true,
            "example": "This is my new line"
          },
          "taxRate": {
            "type": "string",
            "description": "The tax rate.",
            "default": "null",
            "nullable": true,
            "example": "GST"
          },
          "taxAmount": {
            "type": "number",
            "description": "The tax amount.",
            "format": "decimal",
            "default": "null",
            "nullable": true,
            "example": 10
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "Notes related to the bill.",
      "default": "null",
      "nullable": true,
      "example": "This is a note."
    }
  },
  "required": [
    "bookId",
    "supplier",
    "billDate",
    "amountTaxStatus",
    "lineItems"
  ]
}