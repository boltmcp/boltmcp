      "format": "int32",
      "default": 1
    },
    "perPage": {
      "description": "The number of suppliers per page.",
      "type": "integer",
      "format": "int32",
      "default": 0,
      "nullable": true
    },
    "ExternalClientId": {
      "description": "The external client application's id.",
      "type": "string",
      "format": "guid",
      "example": "2296ba1d-c0c4-44d2-bf12-9681098a9afa"
    },
    "ExternalTenancyId": {
      "description": "The external book/file/tenancy/etc's id.",
      "type": "string",
      "nullable": true,
      "example": "1293848"
    }
  },
  "required": [
