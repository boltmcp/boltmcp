{
  "type": "object",
  "properties": {
    "bookId": {
      "description": "The book id.",
      "type": "string",
      "format": "guid"
    },
    "paytemplateId": {
      "description": "The paytemplate id to be updated.",
      "type": "string",
      "format": "guid"
    },
    "name": {
      "type": "string",
      "description": "The name of the pay template.",
      "nullable": true,
      "example": "Pay Template 1"
    },
    "classifications": {
      "type": "array",
      "description": "The classifications for the pay template.",
      "nullable": true,
      "items": {
        "type": "object",
        "description": "Pay Template Classification Put",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "The pay template classification id.",
            "format": "guid",
            "nullable": true
          },
          "classification": {
            "type": "string",
            "description": "Pay template enterprise agreement or award classification.",
            "nullable": true,
            "example": "Agreement classification 1"
          },
          "rateType": {
            "description": "Rate type.",
            "example": "Hourly",
            "anyOf": [
              {
                "type": "string",
                "description": "Rate type of pay item.",
                "x-enumNames": [
                  "Salary",
                  "Hourly"
                ],
                "enum": [
                  "Salary",
                  "Hourly"
                ]
              }
            ]
          },
          "fullTimeAmount": {
            "type": "number",
            "description": "Fulltime amount.",
            "format": "decimal",
            "example": 100
          },
          "casualAmount": {
            "type": "number",
            "description": "Casual amount.",
            "format": "decimal",
            "nullable": true,
            "example": 100
          },
          "casualPercentage": {
            "type": "number",
            "description": "Casual percentage.",
            "format": "decimal",
            "nullable": true,
            "example": 100
          }
        }
      }
    }
  },
  "required": [
    "bookId",
    "paytemplateId"
  ]
}