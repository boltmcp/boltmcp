{
  "type": "object",
  "properties": {
    "bookId": {
      "description": "The book's id.",
      "type": "string",
      "format": "guid"
    },
    "ledgerAccountId": {
      "description": "The ledger account's id.",
      "type": "string",
      "format": "guid"
    },
    "ExternalResourceId": {
      "description": "The external resource's id.",
      "type": "string",
      "nullable": true,
      "example": "134"
    },
    "ExternalClientId": {
      "description": "The external client application's id.",
      "type": "string",
      "format": "guid",
      "example": "2296ba1d-c0c4-44d2-bf12-9681098a9afa"
    },
    "ExternalTenancyId": {
      "description": "The external book/file/tenancy/etc's id.",
      "type": "string",
      "nullable": true,
      "example": "1293848"
    },
    "name": {
      "type": "string",
      "description": "The name of the account.",
      "nullable": true,
      "example": "Widget income"
    },
    "description": {
      "type": "string",
      "description": "The description of the account.",
      "nullable": true,
      "example": "Income from sales of widgets"
    },
    "parentLedgerAccount": {
      "type": "string",
      "description": "The parent ledger account if there is one.",
      "nullable": true,
      "example": "Income"
    },
    "sortOrder": {
      "type": "integer",
      "description": "The order in which the user would like to sort the account relative to other accounts.",
      "format": "int32",
      "nullable": true,
      "example": 1
    },
    "status": {
      "description": "The account status.",
      "nullable": true,
      "example": "Active",
      "anyOf": [
        {
          "type": "string",
          "description": "The status of a ledger account.",
          "x-enumNames": [
            "Active",
            "Inactive"
          ],
          "enum": [
            "Active",
            "Inactive"
          ]
        }
      ]
    },
    "defaultTaxRate": {
      "type": "string",
      "description": "The default tax rate for the account.",
      "nullable": true,
      "example": "NCG"
    },
    "accountCode": {
      "type": "string",
      "description": "The account code.",
      "nullable": true,
      "example": "2-2040"
    },
    "exportCode": {
      "type": "string",
      "description": "The export code for the account.",
      "nullable": true,
      "example": "ABC-99"
    },
    "bankAccount": {
      "description": "The bank account details - **only** when the `accountType` is `CurrentAsset_Bank`.",
      "nullable": true,
      "anyOf": [
        {
          "type": "object",
          "description": "Bank account details.",
          "additionalProperties": false,
          "properties": {
            "closedAsOfDate": {
              "type": "string",
              "description": "When the account was closed.",
              "format": "date-time",
              "nullable": true,
              "example": "2022-01-13"
            },
            "dateOpened": {
              "type": "string",
              "description": "When the bank account was opened.",
              "format": "date-time",
              "nullable": true,
              "example": "2020-05-14"
            },
            "lockoffDate": {
              "type": "string",
              "description": "The date when transactions are locked.\nTransactions dated on or before this date cannot be amended.",
              "format": "date-time",
              "nullable": true,
              "example": "2020-06-30"
            },
            "bankBranchNumber": {
              "type": "string",
              "description": "The bank branch number (BSB in Australia, Sort Code in UK).",
              "nullable": true,
              "example": "123456"
            },
            "bankAccountName": {
              "type": "string",
              "description": "The name of the account holder.",
              "maxLength": 26,
              "nullable": true,
              "example": "John Smith"
            },
            "bankAccountNumber": {
              "type": "string",
              "description": "The bank account number.",
              "nullable": true,
              "example": "987654"
            },
            "openingBalance": {
              "type": "number",
              "description": "The bank account's opening balance.",
              "format": "decimal",
              "nullable": true,
              "example": 1000
            },
            "financialInstitution": {
              "type": "string",
              "description": "The id of the financial institution.",
              "format": "guid",
              "nullable": true,
              "example": "76efba3f-2483-4bb8-88e3-7f0786366a6c"
            },
            "includeBalancingTransaction": {
              "type": "boolean",
              "description": "Whether to include a balancing transaction.",
              "example": false
            },
            "payerIdentifier": {
              "type": "string",
              "description": "The APCA number to identify the payer.",
              "nullable": true,
              "example": "125876"
            }
          }
        }
      ]
    },
    "creditAccount": {
      "description": "The credit account details - **only** when the `accountType` is `CurrentLiability_CreditCard`.",
      "nullable": true,
      "anyOf": [
        {
          "type": "object",
          "description": "Credit account details.",
          "additionalProperties": false,
          "properties": {
            "closedAsOfDate": {
              "type": "string",
              "description": "When the account was closed.",
              "format": "date-time",
              "nullable": true,
              "example": "2022-01-13"
            },
            "dateOpened": {
              "type": "string",
              "description": "When the credit account was opened.",
              "format": "date-time",
              "nullable": true,
              "example": "2020-05-14"
            },
            "lockoffDate": {
              "type": "string",
              "description": "The date when transactions are locked.\nTransactions dated on or before this date cannot be amended.",
              "format": "date-time",
              "nullable": true,
              "example": "2020-06-30"
            },
            "openingBalance": {
              "type": "number",
              "description": "The credit account's opening balance.",
              "format": "decimal",
              "nullable": true,
              "example": 1000
            }
          }
        }
      ]
    }
  },
  "required": [
    "bookId",
    "ledgerAccountId"
  ]
}