{
  "type": "object",
  "properties": {
    "bookId": {
      "description": "The book's id.",
      "type": "string",
      "format": "guid"
    },
    "paymentId": {
      "description": "The payments's id.",
      "type": "string",
      "format": "guid"
    },
    "supplier": {
      "type": "string",
      "description": "The supplier.",
      "nullable": true,
      "example": "Company Ltd"
    },
    "paymentDate": {
      "type": "string",
      "description": "The date of the payment.",
      "format": "date-time",
      "nullable": true,
      "example": "2020-02-06"
    },
    "ledgerAccount": {
      "type": "string",
      "description": "The id or name of the bank/cash/credit account where the money was withdrawn.",
      "nullable": true,
      "example": "My bank account"
    },
    "paymentMethod": {
      "type": "string",
      "description": "The id or name of the payment method used.",
      "nullable": true,
      "example": "Mastercard"
    },
    "reference": {
      "type": "string",
      "description": "The payment reference.",
      "nullable": true,
      "example": "My reference"
    },
    "notes": {
      "type": "string",
      "description": "Notes related to the payment.",
      "nullable": true,
      "example": "This is a note."
    },
    "totalAmount": {
      "type": "number",
      "description": "The total amount of the bill.",
      "format": "decimal",
      "example": 110
    },
    "reconciliationStatus": {
      "description": "The payment's reconciliation status.\nNote that this can only be initially set to Cleared or Uncleared and that it can only be updated via a bank reconciliation.",
      "nullable": true,
      "example": "Cleared",
      "anyOf": [
        {
          "type": "string",
          "description": "Reconciliation status.",
          "x-enumNames": [
            "Uncleared",
            "Cleared",
            "Reconciled"
          ],
          "enum": [
            "Uncleared",
            "Cleared",
            "Reconciled"
          ]
        }
      ]
    },
    "internalNotes": {
      "type": "string",
      "description": "Internal Notes related to the payment.",
      "nullable": true,
      "example": "This is an internal note."
    },
    "classification": {
      "type": "string",
      "description": "The classification.",
      "nullable": true,
      "example": "My classification"
    }
  },
  "required": [
    "bookId",
    "paymentId"
  ]
}