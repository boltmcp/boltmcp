{
  "type": "object",
  "properties": {
    "token_address": {
      "description": "Token program address (base58-44 string). See tokens for valid addresses.",
      "default": "So11111111111111111111111111111111111111112",
      "example": "So11111111111111111111111111111111111111112",
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$",
      "type": "string"
    },
    "interval": {
      "description": "Time interval for price aggregation. One of: 1H, 2H, 4H, 6H, 8H, 12H, 1D, 3D, 1W, 1M.",
      "default": "1H",
      "enum": [
        "1h",
        "2h",
        "4h",
        "6h",
        "8h",
        "12h",
        "1D",
        "3D",
        "1W",
        "1M"
      ],
      "example": "1H",
      "type": "string"
    },
    "limit": {
      "description": "Limit the number of results.",
      "default": 100,
      "maximum": 1000,
      "minimum": 1,
      "type": "integer"
    },
    "offset": {
      "description": "Offset the results, allows you to skip a number of rows before starting to return rows.",
      "default": 0,
      "maximum": 100000,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "token_address",
    "interval"
  ]
}