    "cover_image_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "title": "Cover Image Id"
    },
    "tags": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Tags"
    },
    "title": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 255,
