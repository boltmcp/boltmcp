  "properties": {
    "aspect_id": {
      "type": "string",
      "format": "uuid",
      "title": "Aspect Id"
    },
    "website_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "maxLength": 2047,
      "title": "Website Url",
      "examples": [
        "https://intree.com"
      ]
    },
    "phone": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 255
        },
        {
          "type": "null"
        }
      ],
      "title": "Phone",
      "examples": [
        "+4512345678"
      ]
    },
    "video_url": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 2047
        },
        {
          "type": "null"
        }
      ],
      "title": "Video Url",
      "examples": [
        "https://youtu.be/02IsQyHiEV6"
      ]
    },
    "email": {
      "anyOf": [
        {
          "type": "string",
          "format": "email"
        },
        {
          "type": "null"
        }
      ],
      "maxLength": 255,
      "title": "Email",
      "examples": [
        "johndoe@gmail.com"
      ]
