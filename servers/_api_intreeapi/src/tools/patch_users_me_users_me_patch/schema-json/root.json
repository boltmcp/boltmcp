{
  "type": "object",
  "properties": {
    "full_name": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 255,
          "minLength": 1,
          "examples": [
            "Lars Smart"
          ]
        },
        {
          "type": "null"
        }
      ],
      "title": "Full Name"
    },
    "username": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 30,
          "minLength": 3,
          "description": "Only alphanumeric characters are allowed: `a-z` `A-Z`, `0-9`. If the username starts with `^`, it is autogenerated -> consider masking.",
          "examples": [
            "LarSmart"
          ]
        },
        {
          "type": "null"
        }
      ],
      "title": "Username"
    },
    "is_public": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Is Public",
      "description": "Enable if the user can be found by username."
    },
    "avatar_image_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "title": "Avatar Image Id"
    },
    "cover_image_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ],
      "title": "Cover Image Id"
    }
  },
  "required": []
}