{
  "type": "object",
  "properties": {
    "require_handshake": {
      "description": "If true, then old refresh tokens will not be invalidated.",
      "type": "boolean",
      "default": false,
      "title": "Require Handshake"
    },
    "dev_access_expiry_minutes": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Dev Access Expiry Minutes",
      "default": 120
    },
    "dev_refresh_expiry_minutes": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Dev Refresh Expiry Minutes",
      "default": 129600
    },
    "refresh_token": {
      "type": "string",
      "title": "Refresh Token",
      "examples": [
        "xxxx.yyyy.zzzz"
      ]
    }
  },
  "required": [
    "refresh_token"
  ]
}