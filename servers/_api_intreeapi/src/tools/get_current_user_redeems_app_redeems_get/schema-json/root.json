    "sort_by": {
      "description": "Sort by options for redeems.\n\n`title`: sort by the title of the redeemed treet\n`created_at`: sort by when the redeem was made",
      "default": "desc(created_at)",
      "type": "string",
      "enum": [
        "asc(title)",
        "desc(title)",
        "asc(created_at)",
        "desc(created_at)"
      ],
      "title": "AppRedeemSortBy"
    },
